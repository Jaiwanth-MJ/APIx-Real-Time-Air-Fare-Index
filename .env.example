# .env.example
# Copy to .env and configure for your environment

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL / TimescaleDB or SQLite connection string
DATABASE_URL=sqlite:///./apix.db
POSTGRES_DB=apix
POSTGRES_USER=apix_user
POSTGRES_PASSWORD=apix_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW=raw_fares
KAFKA_TOPIC_CLEAN=cleaned_fares

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Proxy (residential proxy service) ───────────────────────────────────────
PROXY_URL=
PROXY_HEALTH_URL=

# ── CAPTCHA ──────────────────────────────────────────────────────────────────
TWOCAPTCHA_API_KEY=mock_key_sih2026

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///./airflow.db
ALERT_EMAIL=admin@apix.gov.in

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000
